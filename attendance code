}

string getDate () { //gets the date from the user
    string date;
    cout << "Enter date as month-day-year\n";
    cin >> date;
    while (date.find('/') != string::npos) {
        cout << "Invalid input. Do not use slashes.\n";
        cout << "Enter date as month-day-year\n";
        cin >> date;
    }
    return date;
}

int getAttendance () { //gets attendance status with validation
    int attendanceStatus = 0;
    cin >> attendanceStatus;

    while (!cin || attendanceStatus < 1 || attendanceStatus > 2) {
        cout << "Invalid input. Enter 1 for Yes or 2 for No: ";
        cin.clear();
        cin.ignore(10000, '\n');
        cin >> attendanceStatus;
    }

    return attendanceStatus;
}

void takeAttendance (vector<string>& names, vector<string>& attendance, ofstream& MyFile) { //records attendance for every student
    for (int i = 0; i < names.size(); i++) {
        cout << "\n-----------------------------------" << endl;
        cout << "Is " << names[i] << " present?" << endl;
        cout << "1 - Yes" << endl;
        cout << "2 - No" << endl;
        cout << "Enter choice (1-2): ";
        int attendances = getAttendance();
        if (attendances == 1) { //student is present
            MyFile << names[i] << ", attendance: present\n" << endl;
            attendance.push_back(", attendance: present");
        } else { //student is absent
            MyFile << names[i] << ", attendance: absent\n" << endl;
            attendance.push_back(", attendance: absent");
        }
    }
}

void displayAttendance (vector<string>& names, vector<string>& attendance) { //displays all attendance results
    cout << "\n===================================" << endl;
    cout << "       ATTENDANCE RESULTS" << endl;
    cout << "===================================" << endl;
    for (int i = 0; i < names.size(); i++) {
        cout << names[i] << attendance[i] << endl << endl;
    }
    cout << "===================================" << endl;
}
